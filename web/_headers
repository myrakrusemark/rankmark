# Cross-origin isolation for SharedArrayBuffer (multi-threaded WASM). Weights come
# from huggingface.co, which answers CORS, so require-corp is satisfied.
# One header name per path rule only: Pages joins duplicates with a comma.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# unhashed modules and data: revalidated on every load (ETag makes that a 304),
# so a page never pairs new HTML with last deploy's modules
/engine/*
  Cache-Control: no-cache
/ui/*
  Cache-Control: no-cache
/styles/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache

# the engine build is pinned by hash in the registry; a new build gets a new path
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
